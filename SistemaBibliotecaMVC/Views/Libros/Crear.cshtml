@model SistemaBibliotecaMVC.Models.LibroViewModel

@{
    ViewData["Title"] = ViewData["Title"] ?? "Registrar libro";
}

<style>
    .form-card {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e0d6c3;
        border-radius: 10px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .form-card h2 {
            color: #3b2a1a;
            font-weight: 700;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #e0d6c3;
            padding-bottom: 0.75rem;
        }

    .form-label {
        color: #3b2a1a;
        font-weight: 600;
    }

    .form-control {
        border: 1px solid #d8cdb8;
        border-radius: 6px;
    }

        .form-control:focus {
            border-color: #8a6d3b;
            box-shadow: 0 0 0 0.2rem rgba(138, 109, 59, 0.15);
        }

    .btn-primary {
        background-color: #3b2a1a;
        border-color: #3b2a1a;
        font-weight: 600;
    }

        .btn-primary:hover {
            background-color: #5a4128;
            border-color: #5a4128;
        }

    .btn-secondary {
        background-color: #e0d6c3;
        border-color: #e0d6c3;
        color: #3b2a1a;
        font-weight: 600;
    }

        .btn-secondary:hover {
            background-color: #d1c4a8;
            border-color: #d1c4a8;
            color: #3b2a1a;
        }
</style>

<div class="form-card">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Crear" asp-controller="Libros" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Release" class="form-label"></label>
            <input asp-for="Release" class="form-control" />
            <span asp-validation-for="Release" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <input asp-for="Category" class="form-control" />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Registrar</button>
            <a class="btn btn-secondary" href="/biblioteca/libros">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}